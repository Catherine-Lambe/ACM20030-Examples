Cell["Sometimes operations will return non-elementary functions:", "Text",
 CellChangeTimes->{{3.7921626663899403`*^9, 
  3.792162683758713*^9}},ExpressionUUID->"0b188388-50c5-4a2d-8c08-\
b9f77ddc89a6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"res", "=", 
  RowBox[{"Integrate", "[", 
   RowBox[{
    FractionBox[
     RowBox[{"Cos", "[", "x", "]"}], 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["x", "2"], "+", "1"}], ")"}]], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "1", ",", "5"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.7921626216923113`*^9, 3.792162654768526*^9}},
 CellLabel->
  "In[671]:=",ExpressionUUID->"531f0419-cfd4-4ae5-a0b4-a24db227e6da"],

Cell[BoxData[
 RowBox[{
  FractionBox["1", 
   RowBox[{"4", " ", "\[ExponentialE]"}]], 
  RowBox[{"(", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "\[ImaginaryI]"}], " ", 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       SuperscriptBox["\[ExponentialE]", "2"]}], ")"}], " ", 
     RowBox[{"CosIntegral", "[", 
      RowBox[{
       RowBox[{"-", "5"}], "+", "\[ImaginaryI]"}], "]"}]}], "+", 
    RowBox[{"\[ImaginaryI]", " ", 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       SuperscriptBox["\[ExponentialE]", "2"]}], ")"}], " ", 
     RowBox[{"CosIntegral", "[", 
      RowBox[{
       RowBox[{"-", "1"}], "+", "\[ImaginaryI]"}], "]"}]}], "-", 
    RowBox[{"\[ImaginaryI]", " ", 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       SuperscriptBox["\[ExponentialE]", "2"]}], ")"}], " ", 
     RowBox[{"CosIntegral", "[", 
      RowBox[{"1", "+", "\[ImaginaryI]"}], "]"}]}], "+", 
    RowBox[{"\[ImaginaryI]", " ", 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       SuperscriptBox["\[ExponentialE]", "2"]}], ")"}], " ", 
     RowBox[{"CosIntegral", "[", 
      RowBox[{"5", "+", "\[ImaginaryI]"}], "]"}]}], "-", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "1"}], "+", 
       SuperscriptBox["\[ExponentialE]", "2"]}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SinIntegral", "[", 
        RowBox[{
         RowBox[{"-", "1"}], "+", "\[ImaginaryI]"}], "]"}], "-", 
       RowBox[{"SinIntegral", "[", 
        RowBox[{"1", "+", "\[ImaginaryI]"}], "]"}]}], ")"}]}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "1"}], "+", 
       SuperscriptBox["\[ExponentialE]", "2"]}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SinIntegral", "[", 
        RowBox[{
         RowBox[{"-", "5"}], "+", "\[ImaginaryI]"}], "]"}], "-", 
       RowBox[{"SinIntegral", "[", 
        RowBox[{"5", "+", "\[ImaginaryI]"}], "]"}]}], ")"}]}]}], 
   ")"}]}]], "Output",
 CellChangeTimes->{{3.792162631682283*^9, 3.7921626855930853`*^9}},
