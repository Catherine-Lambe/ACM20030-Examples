Cell[BoxData[
 InterpretationBox[
  RowBox[{
   RowBox[{
    FractionBox["1", "90"], " ", 
    RowBox[{
     SuperscriptBox["f", 
      TagBox[
       RowBox[{"(", "4", ")"}],
       Derivative],
      MultilineFunction->None], "[", "c", "]"}], " ", 
    SuperscriptBox["\[CapitalDelta]x", "5"]}], "+", 
   InterpretationBox[
    SuperscriptBox[
     RowBox[{"O", "[", "\[CapitalDelta]x", "]"}], "6"],
    SeriesData[$CellContext`\[CapitalDelta]x, 0, {}, 5, 6, 1],
    Editable->False]}],
  SeriesData[$CellContext`\[CapitalDelta]x, 0, {
   Rational[1, 90] Derivative[4][$CellContext`f][$CellContext`c]}, 5, 6, 1],
  Editable->False]], "Output",
 CellChangeTimes->{{3.908006882888846*^9, 3.90800688985723*^9}},
 CellLabel->
