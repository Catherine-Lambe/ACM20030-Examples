Cell["Manipulate", "Subsection",
 CellChangeTimes->{{3.792226871995653*^9, 
  3.792226875508835*^9}},ExpressionUUID->"c68246d5-4cc3-4f19-9df5-\
910e82ab8919"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"Sin", "[", 
      RowBox[{"x", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"a", " ", "x"}]}], ")"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "6"}], "}"}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"a", ",", "0", ",", "2"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.7922268767684507`*^9, 3.7922268767703457`*^9}},
 CellLabel->"In[8]:=",ExpressionUUID->"fedca69e-a41c-4fef-a3db-a0676fe937a1"],

