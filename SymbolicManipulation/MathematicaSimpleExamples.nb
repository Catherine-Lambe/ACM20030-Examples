Cell[CellGroupData[{

Cell["Newton-Raphson method", "Subsection",
 CellChangeTimes->{{3.84367200407106*^9, 
  3.843672007166017*^9}},ExpressionUUID->"3785c5e7-f8ef-4f65-983d-\
ee6adb24eb2c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], ":=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"x", "-", "2"}], ")"}], 
   RowBox[{"(", 
    RowBox[{"x", "+", "2"}], ")"}], 
   RowBox[{"(", 
    RowBox[{"x", "+", "3"}], ")"}], 
   RowBox[{"(", 
    RowBox[{"x", "-", "4"}], ")"}]}]}]], "Input",
 CellChangeTimes->{{3.8436720475333357`*^9, 3.84367205433784*^9}, {
  3.8436721753168077`*^9, 3.8436721802214203`*^9}},
 CellLabel->
  "In[400]:=",ExpressionUUID->"463f4cc0-c075-44eb-9b91-cf61d967de6d"],

Cell["\<\
If you want to find the root of a function you can always use Mathematics\
\[CloseCurlyQuote]s FindRoot function\
\>", "Text",
 CellChangeTimes->{{3.843672548282524*^9, 
  3.843672571525235*^9}},ExpressionUUID->"10297cbd-af07-43ff-ac4d-\
b93a8f716ec0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FindRoot", "[", 
  RowBox[{
   RowBox[{"f", "[", "x", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "1"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.843672603882938*^9, 3.843672615829303*^9}},
 CellLabel->
  "In[412]:=",ExpressionUUID->"264d87dd-88b5-402f-b5e4-6d9d621bac06"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"x", "\[Rule]", "2.`"}], "}"}]], "Output",
 CellChangeTimes->{3.84367261612677*^9},
 CellLabel->
  "Out[412]=",ExpressionUUID->"245b06f0-2716-4038-9e24-0b1735bc78a2"]
}, Open  ]],

Cell["\<\
You can also directly implement the Newton-Raphson method using the Nest \
function\
\>", "Text",
 CellChangeTimes->{{3.843672200143466*^9, 3.843672230395739*^9}, {
  3.843672633120326*^9, 
  3.8436726458094482`*^9}},ExpressionUUID->"a9a9bff0-f836-4baf-9867-\
25d38af5c516"],

Cell[BoxData[
 RowBox[{
  RowBox[{"NewtonRaphson", "[", "x_", "]"}], ":=", 
  RowBox[{"x", "-", 
   FractionBox[
    RowBox[{"f", "[", "x", "]"}], 
    RowBox[{
     RowBox[{"f", "'"}], "[", "x", "]"}]]}]}]], "Input",
 CellChangeTimes->{{3.843672261741495*^9, 3.843672304817844*^9}},
 CellLabel->
  "In[407]:=",ExpressionUUID->"1e74e90e-bdb8-40a0-a769-beb0a183afef"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"NestList", "[", 
  RowBox[{"NewtonRaphson", ",", "1.", ",", "5"}], "]"}]], "Input",
 CellChangeTimes->{{3.843672280819853*^9, 3.843672307848638*^9}},
 CellLabel->
  "In[408]:=",ExpressionUUID->"448cd29b-68f5-44a9-b1e0-a9743325396b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "1.`", ",", "2.333333333333333`", ",", "1.978505629477994`", ",", 
   "1.9999803966932461`", ",", "1.9999999999807883`", ",", "2.`"}], 
  "}"}]], "Output",
 CellChangeTimes->{{3.843672285165946*^9, 3.843672308550894*^9}},
 CellLabel->
  "Out[408]=",ExpressionUUID->"8bb154aa-5bec-4c2f-93c4-ba3e0af8160a"]
}, Open  ]],

Cell["\<\
If you want to be fancy and not define the \[OpenCurlyQuote]Newton-Raphson\
\[CloseCurlyQuote] function you can use pure functions as below:\
\>", "Text",
 CellChangeTimes->{{3.843672287344859*^9, 
  3.843672328149181*^9}},ExpressionUUID->"a1a1a1d1-1d15-4b8a-aa3c-\
5fec4b75203f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"NestList", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{"#", "-", 
      FractionBox[
       RowBox[{"f", "[", "#", "]"}], 
       RowBox[{
        RowBox[{"f", "'"}], "[", "#", "]"}]]}], ")"}], "&"}], ",", "1.", ",", 
   "5"}], "]"}]], "Input",
 CellChangeTimes->{{3.843672010105238*^9, 3.843672029182912*^9}, {
  3.843672070706768*^9, 3.8436721017662992`*^9}, {3.843672131984521*^9, 
  3.843672186780345*^9}, {3.8436722405240583`*^9, 3.84367224176889*^9}},
 CellLabel->
  "In[404]:=",ExpressionUUID->"f0fe61e1-85c7-4d96-936d-16f92eb872ac"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "1.`", ",", "2.333333333333333`", ",", "1.978505629477994`", ",", 
   "1.9999803966932461`", ",", "1.9999999999807883`", ",", "2.`"}], 
  "}"}]], "Output",
 CellChangeTimes->{{3.843672099251392*^9, 3.8436721019738503`*^9}, {
   3.8436721324247417`*^9, 3.843672186956153*^9}, 3.84367224249566*^9},
 CellLabel->
  "Out[404]=",ExpressionUUID->"f586b4f6-2f81-456f-a0b4-4d0761a691e7"]
}, Open  ]]
}, Open  ]]
}, Open  ]]
}, Open  ]]
},
