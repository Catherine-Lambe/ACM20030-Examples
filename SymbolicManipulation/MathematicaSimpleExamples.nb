7e8708425ffb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"P2", "[", "x_", "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"f", "[", "a", "]"}], 
    FractionBox[
     RowBox[{
      RowBox[{"(", 
       RowBox[{"x", "-", "b"}], ")"}], 
      RowBox[{"(", 
       RowBox[{"x", "-", "c"}], ")"}]}], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"a", "-", "b"}], ")"}], 
      RowBox[{"(", 
       RowBox[{"a", "-", "c"}], ")"}]}]]}], "+", 
   RowBox[{
    RowBox[{"f", "[", "b", "]"}], 
    FractionBox[
     RowBox[{
      RowBox[{"(", 
       RowBox[{"x", "-", "a"}], ")"}], 
      RowBox[{"(", 
       RowBox[{"x", "-", "c"}], ")"}]}], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"b", "-", "a"}], ")"}], 
      RowBox[{"(", 
       RowBox[{"b", "-", "c"}], ")"}]}]]}], "+", 
   RowBox[{
    RowBox[{"f", "[", "c", "]"}], 
    FractionBox[
     RowBox[{
      RowBox[{"(", 
       RowBox[{"x", "-", "a"}], ")"}], 
      RowBox[{"(", 
       RowBox[{"x", "-", "b"}], ")"}]}], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"c", "-", "a"}], ")"}], 
      RowBox[{"(", 
       RowBox[{"c", "-", "b"}], ")"}]}]]}]}]}]], "Input",
 CellChangeTimes->{{3.792225786297805*^9, 3.792225828620616*^9}},
 CellLabel->
  "In[188]:=",ExpressionUUID->"b149ba74-b8a8-4a88-8773-194598d4b70e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"integral", "=", 
  RowBox[{"Integrate", "[", 
   RowBox[{
    RowBox[{"P2", "[", "x", "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "a", ",", "b"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.792225831929266*^9, 3.7922258538997726`*^9}},
 CellLabel->
  "In[189]:=",ExpressionUUID->"135de0f9-270b-4103-84e0-18422cf18de3"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   RowBox[{"(", 
    RowBox[{"a", "-", "b"}], ")"}], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", " ", "a"}], "+", "b", "-", 
        RowBox[{"3", " ", "c"}]}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"b", "-", "c"}], ")"}], " ", 
      RowBox[{"f", "[", "a", "]"}]}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"a", "+", 
        RowBox[{"2", " ", "b"}], "-", 
        RowBox[{"3", " ", "c"}]}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"a", "-", "c"}], ")"}], " ", 
      RowBox[{"f", "[", "b", "]"}]}], "-", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"a", "-", "b"}], ")"}], "2"], " ", 
      RowBox[{"f", "[", "c", "]"}]}]}], ")"}]}], 
  RowBox[{"6", " ", 
   RowBox[{"(", 
    RowBox[{"a", "-", "c"}], ")"}], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "b"}], "+", "c"}], ")"}]}]]], "Output",
 CellChangeTimes->{{3.792225843467842*^9, 3.79222585432049*^9}, 
   3.908006732466934*^9},
