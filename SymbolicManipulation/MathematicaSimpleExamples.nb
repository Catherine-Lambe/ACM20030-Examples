Cell[CellGroupData[{
Cell["Examples of how to use Mathematica", "Title",
 CellChangeTimes->{{3.7921616869918423`*^9, 
  3.7921616935960608`*^9}},ExpressionUUID->"7ab76728-271d-441a-8704-\
